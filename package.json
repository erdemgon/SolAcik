{
  "name": "sol-acik",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "npm run typecheck && rm -rf .test-build && tsc --module commonjs --target ES2020 --moduleResolution node --esModuleInterop --skipLibCheck --types node --outDir .test-build tests/*.test.ts && node --test .test-build/tests/*.test.js"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-clipboard": "~8.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
